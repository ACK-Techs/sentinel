# Yerel calisma dosyasi. Cloud/Gemini varsayilan, local Gemma opsiyonel.

SENTINEL_CONFIG=./config/sentinel.yaml
SENTINEL_PROFILE=cloud
SENTINEL_MODEL=gemini-2.5-flash
SENTINEL_CLOUD_SUPPORTS_TOOLS=false

SENTINEL_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SENTINEL_API_KEY=<set>

SENTINEL_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
SENTINEL_LOCAL_MODEL=gemma4:latest
SENTINEL_LOCAL_TIMEOUT_SEC=120

ANTHROPIC_API_KEY=anthropic_api_key_placeholder
SENTINEL_ANTHROPIC_MODEL=anthropic_model_placeholder

SENTINEL_HTTP_CONNECT_TIMEOUT_SEC=10
SENTINEL_HTTP_TIMEOUT_SEC=120
SENTINEL_HTTP_MAX_RETRIES=3
SENTINEL_HTTP_RETRY_STATUSES=429,500,502,503,504

SENTINEL_CONTEXT_WINDOW_TOKENS=32000
SENTINEL_CONTEXT_WARN_AT=0.85
SENTINEL_CONTEXT_STRATEGY=truncate

SENTINEL_LOG_LEVEL=INFO
SENTINEL_MAX_TURNS=6
SENTINEL_AUTO_APPROVE=false
SENTINEL_SESSION_DIR=./.sentinel/sessions
SENTINEL_TRAJECTORY_DIR=./.sentinel/trajectories
SENTINEL_TRAJECTORY_ENABLED=false
SENTINEL_EXPERIMENTAL_MCP=false

# Grafana (Faz 4 / doctor) — COS Traefik: juju status + http://192.168.1.6/cos-grafana-0/api/health 200
SENTINEL_GRAFANA_ENABLED=true
SENTINEL_GRAFANA_BASE_URL=http://192.168.1.6/cos-grafana-0
SENTINEL_GRAFANA_HEALTH_PATH=/api/health
SENTINEL_GRAFANA_TIMEOUT_SEC=10
SENTINEL_GRAFANA_TOKEN_ENV=SENTINEL_GRAFANA_TOKEN
SENTINEL_GRAFANA_VERIFY_SSL=true
# Gerekirse service account token ayarlayin:
# SENTINEL_GRAFANA_TOKEN=<set>

# Observability gateway (yerel lab)
SENTINEL_OBSERVABILITY_GATEWAY_ENABLED=true
SENTINEL_OBSERVABILITY_GATEWAY_BASE_URL=http://127.0.0.1:8091
SENTINEL_OBSERVABILITY_GATEWAY_TIMEOUT_SEC=10
SENTINEL_OBSERVABILITY_GATEWAY_TOKEN_ENV=SENTINEL_OBSERVABILITY_GATEWAY_TOKEN
SENTINEL_OBSERVABILITY_GATEWAY_TOKEN=<set>
